# FamilyFirst mobile runtime configuration (demo mode was removed 2026-11-21; the app always uses the live API).
# VITE_API_BASE_URL should include the trailing /api segment expected by apiClient.
VITE_API_BASE_URL="https://api.familyfirst.app/api"

# Public Firebase web app configuration and public Web Push certificate key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
